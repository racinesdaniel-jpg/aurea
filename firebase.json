{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      "README.md",
      "**/.*",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/node_modules/**",
      "functions/**"
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/pago/payphone",
        "function": {
          "functionId": "payphoneReturn",
          "region": "us-central1"
        }
      },
      {
        "source": "/pago/paypal",
        "function": {
          "functionId": "paypalWebhook",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}