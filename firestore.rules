rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores: correo confirmado y dentro de esta lista (debe coincidir con "admins" de firebase-config.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['racinesdaniel@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Perfil: solo estos campos, con su tipo y tamaño; el correo debe ser el de la cuenta
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'registeredAt', 'updatedAt', 'state'])
        && d.email is string && request.auth.token.email != null && d.email.lower() == request.auth.token.email.lower()
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('registeredAt' in d) || d.registeredAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number)
        && (!('state' in d) || (d.state is string && d.state.size() < 400000));
    }

    // Cada persona solo lee y escribe su propio documento; el administrador ve y gestiona todos
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();
      allow read, update, delete: if isAdmin();

      // Diario personal: privado, solo su dueño lo lee y escribe (el administrador no tiene acceso)
      // Id: fecha AAAA-MM-DD (páginas) o f-xxxx (frases guardadas); a lo sumo 40 campos por página
      match /diario/{dia} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') || dia.matches('^f-[a-z0-9]{1,13}$'))
          && request.resource.data.keys().size() <= 40;
      }

      // Datos privados (conversación con el Mentor IA): solo su dueño los lee y escribe, ni el administrador
      match /privado/{doc} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && doc == 'mentor' && request.resource.data.keys().size() <= 10;
      }

      // Consultas al Mentor con IA: la persona ve cuántas usó; solo el servidor las escribe
      match /ia/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }

    // Consumo del Mentor con IA: solo el administrador lo lee; lo escribe el servidor
    match /admin/{doc} {
      allow read: if isAdmin();
    }

    // Suscripciones válidas: solo el administrador (o el servidor de pagos) las escribe; el usuario solo lee la suya
    match /subs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Pagos: solo el servidor los escribe; el administrador los consulta
    match /pagos/{id} {
      allow read: if isAdmin();
    }

    // Contenido de la landing (Administración → Landing): cualquiera lo lee, solo el administrador lo cambia
    match /landing/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Imágenes subidas para la landing (comprimidas, una por documento)
    match /landing_img/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Texto completo de las cápsulas: solo con la prueba vigente o una suscripción activa (lo escribe el servidor)
    function entitled() {
      let ref = /databases/$(database)/documents/subs/$(request.auth.uid);
      let now = request.time.toMillis();
      return exists(ref) && (
        (get(ref).data.get('trialEnd', 0) is number && get(ref).data.get('trialEnd', 0) > now)
        || (get(ref).data.get('active', false) == true && get(ref).data.get('currentPeriodEnd', now + 1) > now));
    }
    match /capsulas/{id} {
      allow read: if request.auth != null && (isAdmin() || entitled());
    }

    // Tráfico de la landing: lo escribe la función «trafico»; solo el administrador lo lee
    match /trafico/{dia} {
      allow read: if isAdmin();
    }

    // Días de prueba y precios: cualquiera los lee (la landing los muestra), solo el administrador los cambia
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
