rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores: correo confirmado y dentro de esta lista (debe coincidir con "admins" de firebase-config.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['racinesdaniel@gmail.com'];
    }

    // Cada persona solo lee y escribe su propio documento; el administrador ve y gestiona todos
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isAdmin();

      // Diario personal: privado, solo su dueño lo lee y escribe (el administrador no tiene acceso)
      match /diario/{dia} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Datos privados (conversación con el Mentor IA): solo su dueño los lee y escribe, ni el administrador
      match /privado/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Consultas al Mentor con IA: la persona ve cuántas usó; solo el servidor las escribe
      match /ia/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow read: if isAdmin();
      }
    }

    // Consumo del Mentor con IA: solo el administrador lo lee; lo escribe el servidor
    match /admin/{doc} {
      allow read: if isAdmin();
    }

    // Suscripciones válidas: solo el administrador (o el servidor de pagos) las escribe; el usuario solo lee la suya
    match /subs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Pagos: solo el servidor los escribe; el administrador los consulta
    match /pagos/{id} {
      allow read: if isAdmin();
    }

    // Contenido de la landing (Administración → Landing): cualquiera lo lee, solo el administrador lo cambia
    match /landing/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Imágenes subidas para la landing (comprimidas, una por documento)
    match /landing_img/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Días de prueba y precios: cualquiera los lee (la landing los muestra), solo el administrador los cambia
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
